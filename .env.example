# ThreatPolish configuration. Copy to .env and fill in real values.
# Never commit the filled file.

# development | test | production
TP_ENV=production

# Required in production: at least 32 characters.
TP_JWT_SECRET=replace-with-a-random-64-character-secret

# Session lifetime in minutes (5-1440).
TP_JWT_TTL_MINUTES=60

# PostgreSQL in production; SQLite is supported for single-node development.
TP_DB_PASSWORD=replace-with-a-strong-database-password
TP_DB_URL=postgresql+psycopg://threatpolish:replace-with-a-strong-database-password@db:5432/threatpolish
# TP_DB_URL=sqlite:///./data/threatpolish.db

# Comma-separated dashboard origins allowed to call the API.
TP_ALLOWED_ORIGINS=http://localhost:5173

# First administrator, created only when the user table is empty.
# Remove these two lines after the first start.
TP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Data directory for decoy spool files and local state.
TP_DATA_DIR=./data

# HTTP decoy
TP_DECOY_ENABLED=true
TP_DECOY_PORT=8022
TP_DECOY_MAX_SESSIONS_PER_HOUR=120

# Event retention and limits
TP_RETENTION_DAYS=90
TP_GRAPH_RETENTION_DAYS=30
TP_RETENTION_GRACE_DAYS=2
# Compose-only: seconds between retention runs (default 24 hours).
TP_RETENTION_INTERVAL_SECONDS=86400
TP_MAX_EVENT_BYTES=65536
TP_INGEST_RATE_LIMIT_PER_MINUTE=6000
TP_CORRELATION_WINDOW_HOURS=72

# Response engine: automatic enforcement is not implemented. Enabling this
# value is a configuration error; every applied action needs explicit approval.
TP_RESPONSE_AUTO_APPLY=false

# Web assessment
TP_WEB_SEC_ALLOW_LOOPBACK=false
TP_WEB_SEC_TIMEOUT_SECONDS=10
TP_WEB_SEC_MAX_REQUESTS_PER_HOST=10

# Sign-in anomaly alerts: two live sessions from different networks inside the
# window are recorded as auth.signin.anomaly.
TP_SIGNIN_ALERT_WINDOW_MINUTES=30
TP_SIGNIN_ALERT_DISTANCE_KM=500
# Optional geolocation endpoint for distance alerts; {ip} is replaced with the
# address. Left empty, alerts report a network change only and no analyst address
# leaves the deployment.
TP_GEO_API_URL=
TP_GEO_API_TOKEN=
TP_GEO_TIMEOUT_SECONDS=3

# Digital-asset data
TP_CRYPTO_PROVIDER=coingecko
TP_CRYPTO_API_BASE=https://api.coingecko.com/api/v3
TP_CRYPTO_TIMEOUT_SECONDS=8
TP_CRYPTO_MIN_REFRESH_SECONDS=60

# Demo seeding (development only): `python -m app.cli seed-demo` creates this
# login when the database has no accounts. Leave the password unset to have one
# generated and printed once; never use these values in production.
# TP_DEMO_EMAIL=demo@threatpolish.local
# TP_DEMO_PASSWORD=

TP_LOG_LEVEL=INFO
