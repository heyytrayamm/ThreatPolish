# ==============================================================================
# ThreatPolish Platform - Environment Configuration Template (.env.example)
#
# NOTE FOR USERS / DEVELOPERS:
# - All development ports are bound to 127.0.0.1 (localhost) by default for safety.
# - Never commit real production secrets, passwords, or public credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="ThreatPolish Honeypot Platform"
APP_VERSION=0.1.0

# Backend Network Settings (Localhost binding for defensive safety)
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
POSTGRES_USER=threatpolish_user
POSTGRES_PASSWORD=threatpolish_dev_secret_change_in_prod
POSTGRES_DB=threatpolish_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://threatpolish_user:threatpolish_dev_secret_change_in_prod@127.0.0.1:5432/threatpolish_db

# Frontend Network Settings
VITE_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
